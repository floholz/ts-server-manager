# TeamSpeak ServerQuery (SSH) connection
TS_HOST=your.teamspeak.host
TS_PORT=10022
TS_USER=serveradmin
TS_PASSWORD=changeme
TS_SID=1

# HTTP server
HTTP_ADDR=:9988
LOG_LEVEL=info

# Update check
DOCKERHUB_REPO=teamspeaksystems/teamspeak6-server
UPDATE_CHECK_TTL=15m

# Scheduled backups (leave BACKUP_DIR empty to disable)
BACKUP_DIR=/backups
BACKUP_INTERVAL=24h
BACKUP_KEEP=14
BACKUP_RATE=2
